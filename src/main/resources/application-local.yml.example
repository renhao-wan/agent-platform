# 本地开发配置模板：复制为 application-local.yml 并填入真实值（该文件已 gitignore）
# 启动：mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# 本文件只填"必须由你提供的值"。base-url / model 的默认值在 application.yml，
# 不在这里重复——重复会让"换供应商"变成两处要同步改的地方。
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/agent_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: root

spring.ai:
  openai:
    api-key: <你的 DeepSeek API Key>
    # 只有要换供应商 / 换模型时才取消下面注释（会覆盖 application.yml 的默认值）
    # base-url: https://api.deepseek.com
    # chat:
    #   options:
    #     model: deepseek-flash
