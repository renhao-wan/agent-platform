# 本地开发配置模板：复制为 application-local.yml 并填入真实值（该文件已 gitignore）
# 启动：java -jar target/agent-platform-0.1.0-SNAPSHOT.jar --spring.profiles.active=local
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/agent_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: root
  data:
    redis:
      port: 6380

spring.ai:
  openai:
    base-url: https://dashscope.aliyuncs.com/compatible-mode   # 或 https://open.bigmodel.cn/api/paas/v4
    api-key: <你的模型 API Key>
    chat:
      options:
        model: qwen-turbo                                      # qwen-plus / glm-4-flash 等 OpenAI 兼容模型

platform:
  agent:
    gateway-api-key: <平台租户 apiKey（POST /admin/tenants 创建获得）>
