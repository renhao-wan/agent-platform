# 复制为 .env 并填入真实值（.env 已 gitignore）。
# 容器启动时由 docker compose 读取：docker compose up -d --build
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 知识库 embedding（SiliconFlow）。留空则整个知识库模块不装配，平台照常启动。
# DeepSeek 没有 embeddings 接口，所以这一项不能复用 LLM_API_KEY。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn
