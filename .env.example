# 复制为 .env 并填入真实值（.env 已 gitignore）。
# 容器启动时由 docker compose 读取：docker compose up -d --build
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# JWT 签名密钥（必填，至少 32 字节）。缺失或过短平台直接拒绝启动。
# 生成：openssl rand -base64 48
JWT_SECRET=

# 知识库 embedding（SiliconFlow）。留空则整个知识库模块不装配，平台照常启动。
# DeepSeek 没有 embeddings 接口，所以这一项不能复用 LLM_API_KEY。
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn

# 工具路由决策模型 wattai（可选）。工具数达到 20 才会触发路由；
# 留空则请求不带 Authorization 头，路由失败会自动弃权并回落全量工具，不影响对话。
WATTAI_API_KEY=
